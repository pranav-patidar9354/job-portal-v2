# Option 1: Direct Neon / PostgreSQL Connection String (Recommended for Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Individual Database Parameters (Used if DATABASE_URL is not set)
